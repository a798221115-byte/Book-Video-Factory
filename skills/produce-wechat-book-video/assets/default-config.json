    "stage1": "highpass=f=65,lowpass=f=12000,equalizer=f=250:t=q:w=1.0:g=1.0,equalizer=f=3200:t=q:w=1.15:g=-2.0,acompressor=threshold=0.15:ratio=1.2:attack=25:release=220:makeup=1.0,loudnorm=I=-15.5:LRA=10:TP=-1.5",
    "stage2": "volume=1.25,alimiter=limit=0.88:level=false"
