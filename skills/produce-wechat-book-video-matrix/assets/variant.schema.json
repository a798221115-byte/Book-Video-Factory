{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant.schema.json",
  "title": "Book video account variant",
  "type": "object",
  "required": ["schemaVersion", "variantId", "campaignId", "accountId", "variantLevel", "status", "gates", "paths", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "variantId": {"type": "string"},
    "campaignId": {"type": "string"},
    "accountId": {"type": "string"},
    "variantLevel": {"enum": ["metadata", "light", "deep"]},
    "status": {"enum": ["initialized", "waiting_copy_confirmation", "producing", "waiting_images_confirmation", "delivered", "publication_pending", "published", "failed", "superseded"]},
    "audienceAngle": {"type": ["string", "null"]},
    "changedDimensions": {"type": "array", "items": {"type": "string"}},
    "gates": {"type": "object", "required": ["MG02", "MG04"]},
    "paths": {"type": "object"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
