{
  "referenceAcquisition": {
    "provider": "TikHub",
    "apiKeyEnv": "TIKHUB_API_KEY",
    "baseUrlEnv": "TIKHUB_BASE_URL",
    "baseUrlDefault": "https://api.tikhub.io",
    "douyinEndpoint": "/api/v1/douyin/web/fetch_one_video",
    "maxAttempts": 3,
    "allowImplicitFallback": false,
    "videoFilename": "reference-YYYY-MM-DD.mp4",
    "metadataPath": "video_clips/reference-metadata.json"
  },
  "projectRoot": "E:/BaiduNetdiskWorkspace/电脑其他文件同步/视频号/AI视频",
  "workflow": {
    "confirmationMode": "two_step",
    "requiredHumanConfirmations": ["script", "images"],
    "autoLockSourcePackage": true,
    "autoSelectTitles": true,
    "autoSelectPublicationTopics": true,
    "autoApprovePassingStyleSample": true,
    "autoStartPostProductionAfterImages": true,
    "autoRegisterDeliveryAfterC02": true,
    "formalPublicationRequiresExplicitAuthorization": true
  },
  "fixedIntro": "固定/女版前3秒固定开头.mp4",
  "introVariantDefault": "female",
  "introVariants": {
    "male": {
      "label": "男版片头",
      "path": "固定/男版前3秒固定开头.mp4",
      "sha256": "151357AE9640CC19BA67B6F057FE2ECE0C022298176044E16FE70DED68D0C3D2",
      "durationSeconds": 2.97,
      "requiredVoiceVariant": "male"
    },
    "female": {
      "label": "女版片头",
      "path": "固定/女版前3秒固定开头.mp4",
      "sha256": "1E42A0DD7D4C3351B26907E200B6BD9768435BF6697DA68408D7A318CA4F2CE4",
      "durationSeconds": 2.97,
      "requiredVoiceVariant": "female"
    }
  },
  "requireVoiceIntroVariantMatch": true,
  "titleSelection": {
    "source": "TikHub Douyin title",
    "formulaSkill": "dbs-xhs-title",
    "formulaMatchCount": [5, 8],
    "minimumTriggerCategories": 3,
    "longCandidateCount": 10,
    "targetSourceLengthRatio": [0.8, 1.2],
    "requireLongSelectionBeforeShortGeneration": true,
    "selectionMode": "automatic-first-recommendation",
    "shortCandidateCount": 10,
    "shortPreferredChineseCharacters": [4, 12],
    "shortMaximumCharacters": 16,
    "requireAllSelectionsBeforeImages": true,
    "emitNonBlockingFeedbackCard": true,
    "feedbackCardChannel": "current_conversation",
    "feedbackCardIncludes": ["titles_json_attachment_or_link", "all_10_long_titles", "all_10_short_titles", "all_10_topic_sets", "adopted_long_title", "adopted_short_title", "adopted_topic_set", "reselection_syntax", "rollback_hint"],
    "feedbackCardCandidateDisplay": "always_show_all_10_long_all_10_short_and_all_10_topic_sets",
    "feedbackCardNumbering": { "long": "L01-L10", "short": "S01-S10", "topic": "T01-T10" },
    "reselectionReplyExample": "长标题 L04，短标题 S07，话题 T03",
    "regenerateShortCandidatesWhenLongChanges": true,
    "regenerateTopicCandidatesWhenLongChanges": true,
    "productionContinuesAfterFeedback": true,
    "includeCandidateDocumentInFinalDelivery": true,
    "includeAdoptedTrioInFinalDelivery": true,
    "requireTitlesArtifactInDeliveryManifest": true,
    "topicCandidateCount": 10,
    "topicsPerCandidate": 7,
    "topicSeparator": " ",
    "topicPrefix": "#",
    "topicRequiredInEveryCandidate": ["#读书", "#好书推荐", "#《{bookTitle}》"],
    "topicDefaultFirstCandidate": ["#读书", "#好书推荐", "#人生感悟", "#认知成长", "#自我提升", "#文字的力量", "#《{bookTitle}》"],
    "topicContextualSlots": 4,
    "topicRequireUniqueWithinCandidate": true,
    "topicSelectionMode": "automatic-first-recommendation",
    "topicCandidateNumbering": "T01-T10",
    "requireResolvedTopicsInTitlesArtifact": true,
    "requireTopicRecommendationReason": true,
    "requireAllTopicCandidatesInFinalDelivery": true,
    "includeResolvedTopicsInFinalDelivery": true,
    "artifact": "titles.json"
  },
  "storyboardSegmentation": {
    "strategy": "semantic-first",
    "fixedImageCount": null,
    "minimumImageCount": null,
    "maximumImageCount": null,
    "targetSecondsPerImage": 8,
    "targetSecondsIsSoft": true,
    "splitOn": ["idea_change", "action_change", "scene_change", "emotion_change", "narrative_function_change"],
    "preserveWholeUnits": ["causal_statement", "contrast", "emotional_unit"],
    "forbidFillerToReachCount": true
  },
  "visualGrammar": {
    "personIsDefaultSubject": false,
    "subjectModes": ["character", "space", "landscape", "object", "architecture", "weather"],
    "characterNecessityValues": ["required", "helpful", "not_needed"],
    "requireCharacterJustificationWhenRequired": true,
    "preferNonCharacterWhenMorePrecise": true,
    "allCharacterStoryboardPolicy": "review_and_replan_unless_every_scene_is_justified",
    "fixedCharacterQuota": null,
    "forbidDecorativePersonForContinuity": true,
    "forbidUnrelatedSceneryFiller": true,
    "mirrorPolicy": "avoid_by_default",
    "allowHumanReflectionOnlyWhenExplicitlyRequested": true,
    "humanReflectionSurfaces": ["mirror", "reflective_glass", "water", "polished_metal", "screen"],
    "requireReflectionConsistencyAudit": true,
    "reflectionConsistencyChecks": ["identity", "pose", "gaze", "limb_count", "handedness", "object_placement", "perspective", "lighting"],
    "reflectionMismatchIsBlocking": true
  },
  "stillImageMotion": {
    "enabled": true,
    "assignment": "deterministic-random",
    "avoidAdjacentDuplicates": true,
    "oneMotionPerImage": true,
    "motions": ["zoom-out", "zoom-in", "pan-left-to-right", "pan-right-to-left"],
    "zoomRange": [1.0, 1.2],
    "referenceDurationSeconds": 8,
    "durationMode": "normalize-to-shot",
    "easing": "smoothstep",
    "supersample": 2,
    "fps": 60
  },
  "backgroundMusic": "固定/背景音乐.mp3",
  "voicePreset": "assets/voice-presets/female-book-narrator-locked-v1.json",
  "voicePresetDefaultVariant": "female",
  "voicePresets": {
    "male": {
      "label": "男版音色",
      "projectPreset": "assets/voice-presets/male-podcast-locked-v2.json",
      "bundledPreset": "assets/male-podcast-locked-v2.json"
    },
    "female": {
      "label": "女版音色",
      "projectPreset": "assets/voice-presets/female-book-narrator-locked-v1.json",
      "bundledPreset": "assets/female-book-narrator-locked-v1.json"
    }
  },
  "bundledVoicePreset": "assets/female-book-narrator-locked-v1.json",
  "bundledVoiceReference": "assets/female-book-narrator-locked-v1-reference.wav",
  "bundledVoiceGoldenMaster": "assets/female-book-narrator-locked-v1-full.wav",
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 60,
    "videoCodec": "libx264",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioRate": 48000
  },
  "cover": {
    "width": 1080,
    "height": 1260,
    "ratio": "6:7",
    "format": "png",
    "embedInVideoAfterApproval": false,
    "embedDurationSeconds": 0.0,
    "embedPosition": null,
    "preserveApprovedAudio": true,
    "audioOffsetSeconds": 0.0,
    "deliveryMode": "separate_upload_asset_only",
    "coverGenerationEndsWorkflow": true,
    "doNotMutateApprovedVideo": true,
    "requireVerifiedOriginalBookCover": true,
    "preserveOriginalCoverArtworkAndTypography": true,
    "confirmationRequiredAfterVideoApproval": false
  },
  "music": {
    "introGain": 0.63,
    "bodyGain": 0.63,
    "fadeOutSeconds": 1.0,
    "duckThreshold": 0.018,
    "duckRatio": 4.0,
    "duckAttackMs": 10,
    "duckReleaseMs": 220
  },
  "voiceGeneration": {
    "engine": "VoxCPM2",
    "model": "openbmb/VoxCPM2",
    "referenceMode": "prompt_and_reference",
    "cfgValue": 2.0,
    "inferenceTimesteps": 20,
    "seed": 42,
    "normalize": false,
    "denoise": false,
    "retryBadcase": false,
    "speechSpeed": 0.92,
    "timeStretchMethod": "ffmpeg-atempo-pitch-preserving",
    "bookNamePauseSeconds": 2.3,
    "ordinaryPauseSeconds": [0.85, 0.85],
    "finalPauseSeconds": 0.5,
    "prosodyProfile": "gentle-reflective"
  },
  "voiceClarity": {
    "variant": "female-locked-v1",
    "preGain": 1.0,
    "highPassHz": 75,
    "presenceEqualizer": "equalizer=f=3200:t=q:w=1.1:g=1.5",
    "compressorThreshold": 0.12,
    "compressorRatio": 1.4,
    "compressorAttackMs": 12,
    "compressorReleaseMs": 140,
    "compressorMakeup": 1.02,
    "loudnessTargetLufs": -15.1,
    "loudnessRangeLu": 8.0,
    "truePeakTargetDbfs": -1.0,
    "postGain": 1.45,
    "limiter": 0.91,
    "stage1": "highpass=f=75,equalizer=f=3200:t=q:w=1.1:g=1.5,acompressor=threshold=0.12:ratio=1.4:attack=12:release=140:makeup=1.02,loudnorm=I=-15.1:LRA=8:TP=-1.0",
    "stage2": "volume=1.45,alimiter=limit=0.91:level=false"
  },
  "captions": {
    "bilingual": true,
    "singleLine": true,
    "forbiddenChinesePunctuation": "，。",
    "typography": {
      "bookTitleSize": 88,
      "authorSize": 48,
      "chineseCaptionSize": 68,
      "englishCaptionSize": 30,
      "bookTitleColor": "浅橙色",
      "authorColor": "浅蓝色",
      "headerGroupVerticalShiftRatio": 0.1,
      "headerPositionsPx": {
        "column": 287,
        "bookTitle": 357,
        "author": 467
      },
      "captionPositionsPx": {
        "alignment": 2,
        "chineseMarginV": 560,
        "englishMarginV": 510,
        "renderAsSeparateStyles": true
      },
      "unit": "rendered_canvas_font_size"
    }
  },
  "feishu": {
    "enabled": true,
    "binding": "integrations/feishu-book-pipeline.json",
    "credentialsFile": "F:/Codex/.secrets/feishu.env",
    "syncAfterEveryStep": true
  },
  "bodyStartsWithBookTitle": true,
  "fixedIntroContainsOpeningSentence": true
}
