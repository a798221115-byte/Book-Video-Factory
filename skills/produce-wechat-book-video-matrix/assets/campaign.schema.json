{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "title": "Book video matrix campaign",
  "type": "object",
  "required": ["schemaVersion", "campaignId", "mode", "sourceProject", "sourceLock", "accounts", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "campaignId": {"type": "string"},
    "mode": {"const": "shadow"},
    "sourceProject": {"type": "string"},
    "sourceLock": {"type": "string"},
    "accounts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["accountId", "variantPath", "status"]}},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
