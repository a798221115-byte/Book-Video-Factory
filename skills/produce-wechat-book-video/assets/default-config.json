{
  "referenceAcquisition": {
    "provider": "TikHub",
    "apiKeyEnv": "TIKHUB_API_KEY",
    "baseUrlEnv": "TIKHUB_BASE_URL",
    "baseUrlDefault": "https://api.tikhub.io",
    "douyinEndpoint": "/api/v1/douyin/web/fetch_one_video",
    "maxAttempts": 3,
    "allowImplicitFallback": false,
    "videoFilename": "reference-YYYY-MM-DD.mp4",
    "metadataPath": "video_clips/reference-metadata.json"
  },
  "projectRoot": "E:/BaiduNetdiskWorkspace/电脑其他文件同步/视频号/AI视频",
  "imageGeneration": {
    "provider": "openai-gpt-image-2-api-kit",
    "model": "gpt-image-2",
    "generationEndpoint": "/images/generations",
    "editEndpoint": "/images/edits",
    "baseUrlDefault": "https://api.openai.com/v1",
    "baseUrlEnv": "GPT_IMAGE2_BASE_URL",
    "modelEnv": "GPT_IMAGE2_MODEL",
    "apiKitFileEnv": "GPT_IMAGE2_KIT_FILE",
    "apiKitFileDefault": "E:/BaiduNetdiskWorkspace/电脑其他文件同步/视频号/配置/GPTImage2.txt",
    "apiKeyLinePattern": "^sk-\\S+$",
    "loadSecretAtRuntimeOnly": true,
    "allowImplicitProviderFallback": false,
    "allowBuiltInImagegen": false,
    "storyboardRequestSize": "1024x1792",
    "storyboardDeliverySize": "1080x1920",
    "outputFormat": "png"
  },
  "workflow": {
    "confirmationMode": "two_step",
    "requiredHumanConfirmations": ["script", "images"],
    "directFinalScriptMode": {
      "enabled": true,
      "triggerRequiresExplicitUserIntent": true,
      "triggerPhrases": ["成稿直出"],
      "requiresUsableSuppliedTranscript": true,
      "preserveVerbatimScript": true,
      "skipDerivativeCopy": true,
      "markG01": "not_required_for_user_supplied_final_script",
      "markG02": "approved_by_explicit_user_instruction",
      "startAt": "C01",
      "remainingHumanConfirmation": "images",
      "formalPublicationRequiresExplicitAuthorization": true
    },
    "autoLockSourcePackage": true,
    "autoSelectTitles": true,
    "autoSelectPublicationTopics": true,
    "autoApprovePassingStyleSample": true,
    "autoStartPostProductionAfterImages": true,
    "autoRegisterDeliveryAfterC02": true,
    "formalPublicationRequiresExplicitAuthorization": true
  },
  "fixedIntro": "固定/女版前3秒固定开头.mp4",
  "introVariantDefault": "female",
  "introVariants": {
    "male": {
      "label": "男版片头",
      "path": "固定/男版前3秒固定开头.mp4",
      "sha256": "151357AE9640CC19BA67B6F057FE2ECE0C022298176044E16FE70DED68D0C3D2",
      "durationSeconds": 2.97,
      "requiredVoiceVariant": "male"
    },
    "female": {
      "label": "女版片头",
      "path": "固定/女版前3秒固定开头.mp4",
      "sha256": "1E42A0DD7D4C3351B26907E200B6BD9768435BF6697DA68408D7A318CA4F2CE4",
      "durationSeconds": 2.97,
      "requiredVoiceVariant": "female"
    }
  },
  "requireVoiceIntroVariantMatch": true,
  "titleSelection": {
    "source": "TikHub Douyin title",
    "formulaSkill": "dbs-xhs-title",
    "formulaMatchCount": [5, 8],
    "minimumTriggerCategories": 3,
    "longCandidateCount": 10,
    "longMinimumChineseCharacters": 20,
    "longMaximumChineseCharacters": 40,
    "longChineseCharacterCounting": "unicode_han_only_excluding_punctuation_latin_digits_spaces",
    "longFormulaCombinationCount": [2, 3],
    "longKeywordCount": [3, 6],
    "longKeywordSources": ["verified_book_or_theme", "confirmed_narration", "audience_problem", "emotion", "action", "outcome"],
    "longVariationDimensions": ["formula_combination", "keyword_set", "opening_structure", "conflict_or_benefit_emphasis", "audience_or_scene"],
    "sourceTitleLengthMode": "rhythm_only_not_length_constraint",
    "rejectLongCandidateOutsideRange": true,
    "forbidLongTitleKeywordStuffing": true,
    "requireLongSelectionBeforeShortGeneration": true,
    "selectionMode": "automatic-first-recommendation",
    "shortCandidateCount": 10,
    "shortMinimumChineseCharacters": 8,
    "shortPreferredChineseCharacters": [8, 12],
    "shortMaximumCharacters": 16,
    "shortChineseCharacterCounting": "unicode_han_only_excluding_punctuation_latin_digits_spaces",
    "rejectShortCandidateBelowMinimum": true,
    "requireAllSelectionsBeforeImages": true,
    "emitNonBlockingFeedbackCard": true,
    "feedbackCardChannel": "current_conversation",
    "feedbackCardIncludes": ["titles_json_attachment_or_link", "all_10_long_titles", "all_10_short_titles", "all_10_topic_sets", "adopted_long_title", "adopted_short_title", "adopted_topic_set", "reselection_syntax", "rollback_hint"],
    "feedbackCardCandidateDisplay": "always_show_all_10_long_all_10_short_and_all_10_topic_sets",
    "feedbackCardNumbering": { "long": "L01-L10", "short": "S01-S10", "topic": "T01-T10" },
    "reselectionReplyExample": "长标题 L04，短标题 S07，话题 T03",
    "regenerateShortCandidatesWhenLongChanges": true,
    "regenerateTopicCandidatesWhenLongChanges": true,
    "productionContinuesAfterFeedback": true,
    "includeCandidateDocumentInFinalDelivery": true,
    "includeAdoptedTrioInFinalDelivery": true,
    "requireTitlesArtifactInDeliveryManifest": true,
    "topicCandidateCount": 10,
    "topicsPerCandidate": 7,
    "topicSeparator": " ",
    "topicPrefix": "#",
    "topicRequiredInEveryCandidate": ["#读书", "#好书推荐", "#《{bookTitle}》"],
    "topicDefaultFirstCandidate": ["#读书", "#好书推荐", "#人生感悟", "#认知成长", "#自我提升", "#文字的力量", "#《{bookTitle}》"],
    "topicContextualSlots": 4,
    "topicRequireUniqueWithinCandidate": true,
    "topicSelectionMode": "automatic-first-recommendation",
    "topicCandidateNumbering": "T01-T10",
    "requireResolvedTopicsInTitlesArtifact": true,
    "requireTopicRecommendationReason": true,
    "requireAllTopicCandidatesInFinalDelivery": true,
    "includeResolvedTopicsInFinalDelivery": true,
    "artifact": "titles.json"
  },
  "storyboardSegmentation": {
    "strategy": "semantic-first",
    "fixedImageCount": null,
    "minimumImageCount": null,
    "maximumImageCount": null,
    "targetSecondsPerImage": 8,
    "targetSecondsIsSoft": true,
    "splitOn": ["idea_change", "action_change", "scene_change", "emotion_change", "narrative_function_change"],
    "preserveWholeUnits": ["causal_statement", "contrast", "emotional_unit"],
    "forbidFillerToReachCount": true
  },
  "visualStyle": {
    "profileId": "warm-cinematic-literary-life-v1",
    "lockedByDefault": true,
    "allowOverrideOnlyOnExplicitUserRequest": true,
    "formerDefaultFallbackAllowed": false,
    "canvasRatio": "9:16",
    "referenceAsset": {
      "path": "assets/style-references/warm-cinematic-literary-life-v1.png",
      "sha256": "e76fb34b32e1a206939d3dfe50a2bd7b57840a7580b7982585aae58aa9ad7172",
      "sourceDimensions": [1080, 768],
      "usage": "style_conditioning_only",
      "includeInEveryG03AndG04Generation": true,
      "forbidMontageOrCompositionCopy": true
    },
    "medium": [
      "photorealistic_contemporary_chinese_literary_film_still",
      "candid_daily_life",
      "subtle_analog_film_grain_and_restrained_halation"
    ],
    "background": {
      "value": "warm_neutral_lived_in_environment",
      "finish": "natural_textured_cinematic",
      "requiredDetail": ["warm_ivory_plaster", "oatmeal_beige", "light_walnut", "slate_blue_gray", "soft_golden_light_falloff", "subtle_film_grain", "environmental_depth"],
      "forbidFlatPureBlackFill": true,
      "forbidFlatWhiteBeigeOrGrayFill": true,
      "forbidBlackDominantFrame": true
    },
    "palette": {
      "base": ["warm_ivory", "oatmeal_beige", "light_walnut", "slate_blue_gray", "softened_charcoal", "natural_skin_tone", "restrained_autumn_foliage"],
      "sunlight": "subdued_natural_gold",
      "saturation": "low",
      "mandatoryOrangeAccent": false,
      "forbidSaturatedAccentColors": true,
      "forbidBroadOrangeWash": true,
      "forbidTealOrangeGrade": true
    },
    "lighting": {
      "mode": "natural_low_angle_morning_or_late_afternoon_golden_light",
      "direction": ["soft_side_light", "soft_backlight"],
      "features": ["long_soft_shadows", "luminous_haze", "warm_window_light_for_interiors"],
      "protectShadowDetail": true,
      "protectHighlightDetail": true,
      "forbidUnderexposure": true
    },
    "defaultRecurringCharacter": {
      "useWhenSemanticallySuitable": true,
      "identity": "adult_east_asian_woman",
      "hair": "shoulder_length_softly_wavy_black_hair",
      "makeup": "minimal_natural",
      "wardrobe": ["oatmeal_beige_long_coat", "slate_blue_gray_scarf"],
      "expression": "restrained_and_natural",
      "requireIdentityAndWardrobeContinuity": true,
      "allowChangeOnlyForNarrationReason": true
    },
    "composition": {
      "characterSubjectAreaRatio": [0.4, 0.6],
      "subjectPlacement": ["lower_middle", "left_or_right_side", "environmental_frame", "back_view_on_path"],
      "shotGrammar": ["candid_indoor_action", "empty_architecture", "front_or_three_quarter_environmental_portrait", "relationship_action", "wide_path_or_park", "person_in_landscape", "meaningful_still_life", "back_view_journey"],
      "negativeSpace": "warm_breathable_textured_and_scene_coherent",
      "preserveHeaderAndCaptionLandingAreas": true,
      "forbidCopiedReferenceComposition": true
    },
    "promptPrefix": "Original 9:16 photorealistic contemporary Chinese literary-film still, matching the bundled warm-cinematic-literary-life-v1 style anchor without copying its composition: low-saturation warm-neutral palette of warm ivory, oatmeal beige, light walnut, slate blue-gray and softened charcoal; natural low-angle morning or late-afternoon golden light, gentle side or backlight, long soft shadows, luminous atmospheric haze, realistic skin hair cloth wood concrete and paper, subtle analog film grain and restrained halation, candid unposed daily life, quiet reflective and gently hopeful mood, breathable textured negative space, professional cinematic clarity, original scene, no embedded text.",
    "recurringCharacterPrompt": "same adult East Asian woman across the sequence, shoulder-length softly wavy black hair, minimal makeup, oatmeal-beige long coat, slate-blue-gray scarf, natural body proportions and restrained expression; preserve facial identity, age, hairstyle, coat and scarf colors.",
    "negativePrompt": "copied montage layout, split panels, copied reference composition, copied pose or location, high-key white commercial lifestyle photography, mandatory orange accent, broad orange wash, teal-orange grading, saturated colors, neon, dark oppressive noir, black-dominant void, underexposure, blown highlights, flat beige or gray block, empty digital gradient, glossy advertising, fashion editorial, studio glamour, influencer portrait, porcelain skin, oily skin sheen, heavy makeup, HDR, oversharpening, painterly illustration, anime, CGI, 3D render, distorted anatomy, duplicate person, inconsistent face or wardrobe, embedded words, letters, numbers, Chinese text, English text, subtitles, book title, logo, signature, watermark",
    "referenceFramePolicy": "bundled_anchor_for_style_conditioning_only",
    "forbidReferenceFramesAsProductionBackgrounds": true,
    "qualityChecks": [
      "style_anchor_similarity_without_composition_copy",
      "warm_golden_natural_light",
      "low_saturation_warm_neutral_palette",
      "natural_unretouched_skin",
      "identity_and_wardrobe_continuity",
      "subtle_film_grain_and_haze",
      "textured_environment",
      "shot_grammar_variety",
      "no_black_dominant_or_underexposed_frame",
      "phone_size_subject_legibility",
      "no_embedded_text_logo_or_watermark",
      "no_reference_composition_copy",
      "g03_g04_style_consistency"
    ]
  },
  "visualGrammar": {
    "personIsDefaultSubject": false,
    "subjectModes": ["character", "space", "landscape", "object", "architecture", "weather"],
    "characterNecessityValues": ["required", "helpful", "not_needed"],
    "requireCharacterJustificationWhenRequired": true,
    "preferNonCharacterWhenMorePrecise": true,
    "allCharacterStoryboardPolicy": "review_and_replan_unless_every_scene_is_justified",
    "fixedCharacterQuota": null,
    "forbidDecorativePersonForContinuity": true,
    "forbidUnrelatedSceneryFiller": true,
    "faceOrientations": ["front", "three_quarter_front", "side_profile", "three_quarter_back", "back_view", "not_applicable"],
    "cameraDistances": ["close_up", "medium_portrait", "environmental_portrait", "wide_empty_shot", "object_detail", "landscape"],
    "requireFaceOrientationDiversity": true,
    "forbidSameFaceOrientationAcrossThreeConsecutiveCharacterShots": true,
    "forbidSideProfileDominatedSequence": true,
    "requireSequenceRepetitionAudit": true,
    "preferAtLeastOneNonCharacterBeatWhenSemanticallySupported": true,
    "nonCharacterOptions": ["empty_interior", "object_closeup", "architecture", "weather", "path", "field", "water", "mountain", "sky"],
    "storyboardFieldsRequired": ["subjectMode", "faceOrientation", "cameraDistance", "narrativeFunction"],
    "mirrorPolicy": "avoid_by_default",
    "allowHumanReflectionOnlyWhenExplicitlyRequested": true,
    "humanReflectionSurfaces": ["mirror", "reflective_glass", "water", "polished_metal", "screen"],
    "requireReflectionConsistencyAudit": true,
    "reflectionConsistencyChecks": ["identity", "pose", "gaze", "limb_count", "handedness", "object_placement", "perspective", "lighting"],
    "reflectionMismatchIsBlocking": true
  },
  "stillImageMotion": {
    "enabled": true,
    "assignment": "deterministic-random",
    "avoidAdjacentDuplicates": true,
    "oneMotionPerImage": true,
    "motions": ["zoom-out", "zoom-in", "pan-left-to-right", "pan-right-to-left"],
    "zoomRange": [1.0, 1.2],
    "referenceDurationSeconds": 8,
    "durationMode": "normalize-to-shot",
    "easing": "smoothstep",
    "supersample": 2,
    "fps": 60
  },
